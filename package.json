{
  "name": "web-component-diff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:fixtures": "tsx scripts/generate-fixtures.ts",
    "prebuild": "npm run generate:fixtures",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "angular": "1.8.3",
    "angular-route": "1.8.3"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/angular": "latest",
    "@types/angular-route": "latest",
    "@types/node": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
